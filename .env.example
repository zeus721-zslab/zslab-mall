# ===========================================
# zslab-mall 환경 변수 템플릿
# 사용법: 이 파일을 .env로 복사 후 실제 값 입력
# .env는 .gitignore 처리됨 (절대 커밋 금지)
# ===========================================

# ----- Spring Profile -----
SPRING_PROFILES_ACTIVE=local

# ----- Dockerfile 선택 (Dockerfile.dev | Dockerfile) -----
BACKEND_DOCKERFILE=Dockerfile.dev
FRONTEND_DOCKERFILE=Dockerfile.dev

# ----- Database (MariaDB) -----
# DB_HOST·DB_PORT는 docker-compose.mall.yml에서 zslab_mariadb·3306으로 박제 (로컬·운영 동일)
DB_NAME=zslab_mall
DB_USERNAME=zslab_mall
DB_PASSWORD=

# ----- Redis -----
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=

# ----- JWT -----
JWT_SECRET=
# JWT_EXPIRATION_MS: 액세스 토큰 만료(ms·기본 3600000=1시간). application.yml jwt.expiration-ms가 참조한다.
JWT_EXPIRATION_MS=3600000

# ----- 최초 SUPER_ADMIN 부트스트랩 (Track 38) -----
# SUPER_ADMIN 회원이 하나도 없을 때에만 최초 1회 소비돼 SUPER_ADMIN 계정을 생성한다.
# 이미 SUPER_ADMIN 존재 시 미참조(무작업). 신선한 DB 최초 기동 시 두 값 필수(비어 있으면 기동 실패·Fail Fast).
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# ----- Domain / CORS -----
APP_DOMAIN=zslab-mall.duckdns.org
CORS_ALLOWED_ORIGINS=https://zslab-mall.duckdns.org

# ----- Frontend (Nuxt) -----
# NUXT_PUBLIC_API_BASE: 브라우저->API 베이스 (동일 Origin 상대경로). gateway path split 도입 후 확정.
# NUXT_API_INTERNAL_BASE: SSR->backend 직결 (gateway_net 내부·별칭 mall-backend 사용).
#   Tomcat 엄격 Host 검증이 언더스코어 호스트명(zslab_mall_backend) 거부(커넥터 400) → 언더스코어 없는 별칭으로 회피.
#   키명은 Nuxt runtimeConfig override 규약 NUXT_<UPPER_SNAKE> = NUXT_API_INTERNAL_BASE (nuxt.config runtimeConfig.apiInternalBase 런타임 주입).
NUXT_PUBLIC_API_BASE=/api
NUXT_API_INTERNAL_BASE=http://mall-backend:8080
# FE-43 구매자 데모 로그인 계정(저권한 BUYER). 서버 라우트(/_demo/*) 전용·비공개 runtimeConfig(nuxt.config buyerDemoEmail/Password)로만 소비.
#   NUXT_PUBLIC_ 접두사 금지(클라이언트 번들 노출). 두 값이 비어 있으면 /login 데모 버튼 미표시·/_demo/* 404.
NUXT_BUYER_DEMO_EMAIL=
NUXT_BUYER_DEMO_PASSWORD=
# FE-23 관리자 데모 로그인: 별도 키 없음. docker-compose.mall.yml이 위 ADMIN_BOOTSTRAP_EMAIL/PASSWORD를
#   frontend 컨테이너의 NUXT_ADMIN_DEMO_EMAIL/NUXT_ADMIN_DEMO_PASSWORD(비공개 runtimeConfig·서버 라우트 전용)로 매핑한다.
#   두 값이 비어 있으면 /admin/login 데모 버튼 미표시·/_admin-demo/* 404.
# Track 90-A 셀러 데모 로그인 계정(SELLER 구성원). 서버 라우트(/_seller-demo/*) 전용·비공개 runtimeConfig(layers/seller/nuxt.config sellerDemoEmail/Password)로만 소비.
#   NUXT_PUBLIC_ 접두사 금지(클라이언트 번들 노출). 두 값이 비어 있으면 /seller/login 데모 버튼 미표시·/_seller-demo/* 404.
NUXT_SELLER_DEMO_EMAIL=
NUXT_SELLER_DEMO_PASSWORD=

# ----- File Upload (Track 77 이미지 업로드·서빙) -----
# UPLOAD_PATH: docker-compose.mall.yml이 컨테이너 내부 /app/uploads로 고정 주입하며 named volume mall_uploads도 같은 경로에 마운트한다.
#   .env 값은 compose에서 읽지 않는다(상대값이 마운트 대상에 치환돼 배포 실패한 이력·D-166 보충) — 아래 값은 컨테이너 밖 bootRun 등
#   비-compose 실행용 참고값. 하위에 products/yyyy/MM/{ULID}.{ext}·{ULID}_thumb.{ext}로 저장되고 GET /api/v1/files/** 가 공개 서빙한다.
# UPLOAD_MAX_SIZE: 파일당 최대 바이트(기본 10MB). spring.servlet.multipart.max-file-size와 앱 단 파일별 검증(FILE_TOO_LARGE)이 함께 사용.
#   요청당 최대 20장·요청 합계 220MB는 application.yml 고정. gateway nginx client_max_body_size도 그 이상으로 맞춰야 한다(외부 스택·수동).
UPLOAD_PATH=/app/uploads
UPLOAD_MAX_SIZE=10485760

# ----- Settlement (Track 85) -----
# SETTLEMENT_DEFAULT_COMMISSION_RATE: 플랫폼 기본 수수료율(basis-point·1000=10.00%). 셀러 개별율·카테고리율이 모두 없을 때 적용.
#   V30 백필 상수 1000과 같아야 한다(변경 시 기존 주문 스냅샷은 그대로·신규 주문부터 적용).
# SETTLEMENT_PAYOUT_OFFSET_DAYS: 지급예정일 = 정산 기간 말일 + N일(기본 20).
SETTLEMENT_DEFAULT_COMMISSION_RATE=1000
SETTLEMENT_PAYOUT_OFFSET_DAYS=20

# ----- 셀러 정산계좌 암호화 (Track 89-F·D-188) -----
# BANK_ACCOUNT_ENCRYPTION_KEY: seller_bank_account.account_number AES-256-GCM 키. raw 32바이트 난수를 Base64로 인코딩한 44자.
#   [경고] 이 키를 분실하면 저장된 계좌번호를 영구히 복호화할 수 없다(재등록 외 복구 방법 없음). 운영 반영 전 반드시 키를
#          안전한 곳(비밀 관리 저장소·오프라인 매체 등)에 별도 백업하라 — 서버 .env 하나만 두지 말 것.
#   운영(prod 프로파일)은 이 값이 없으면 기동 실패(fail-fast·JWT_SECRET 동형). docker compose는 .env 값을 빈 문자열로라도 전달하므로
#   컨테이너 기동(로컬 포함)에는 이 키가 반드시 필요하다. application.yml의 개발용 더미 키는 compose 밖(bootRun·테스트)에서만 적용된다.
#   [주의] 운영·로컬에서 서로 다른 키를 쓰면 상대 환경의 계좌 데이터를 읽을 수 없다(dump를 환경 간에 옮기면 계좌 상세 조회가 실패한다).
#   생성 명령(32바이트 난수 → Base64 한 줄):
#     PowerShell: $b=New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
#     bash:       openssl rand -base64 32
#   키 로테이션·백필 절차는 docs/track-89f/ops-checklist.md 참조.
BANK_ACCOUNT_ENCRYPTION_KEY=

# ----- Logging -----
LOG_LEVEL=INFO
LOG_PATH=/app/logs

# ----- Elasticsearch (log 수집) -----
# 무인증 HTTP. 컨테이너명·포트 기본값만 (실값 필요 시 서버 .env 에서 재정의)
ES_HOST=zslab_elasticsearch
ES_PORT=9200

# ===========================================
# 아래는 1차 범위 미사용 (자리 확보)
# ===========================================

# ----- PG / 결제 -----
PG_PROVIDER=
PG_API_KEY=
PG_SECRET_KEY=

# ----- Email (SMTP) -----
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# ----- SMS -----
SMS_API_KEY=